  <!-- Goal marker -->
  <model name="goal_marker">
    <pose>15 15 0.5 0 0 0</pose>
    <link name="goal_link">
      <visual>
        <geometry>
          <sphere size="0.2"/>
        </geometry>
        <material name="green">
          <rgb>0.0 1.0 0.0</rgb>
        </material>
      </visual>
      <collision>
        <geometry>
