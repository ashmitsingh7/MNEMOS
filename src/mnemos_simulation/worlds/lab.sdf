    <model name="west_wall"><static>true</static><pose>-4 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 8 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 8 2</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>4 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 8 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 8 2</size></box></geometry></visual></link></model>
    <model name="workbench"><static>true</static><pose>1.3 1.1 0.45 0 0 0.2</pose><link name="link"><collision name="c"><geometry><box><size>1.6 0.7 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.6 0.7 0.9</size></box></geometry><material><diffuse>0.45 0.25 0.1 1</diffuse></material></visual></link></model>
    <model name="cabinet"><static>true</static><pose>-1.4 1.7 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.8 0.45 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 0.45 1.5</size></box></geometry></visual></link></model>
    <model name="movable_box"><pose>0.9 -1.1 0.25 0 0 0</pose><link name="link"><inertial><mass>4.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial><collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></visual></link></model>
  </world>
