  <!-- Obstacles -->
  <model name="pallet_1">
    <pose>10 10 0.5 0 0 0</pose>
    <link name="pallet_link">
      <visual>
        <geometry>
          <box size="2.0 1.0 0.3"/>
        </geometry>
        <material name="brown">
          <rgb>0.4 0.2 0.1</rgb>
