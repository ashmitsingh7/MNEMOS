<?xml version="1.0"?>
<robot name="mnemos_diff_drive">

  <!-- ===== Base Link ===== -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.25" length="0.1"/>
      </geometry>
      <material name="yellow">
        <rgb>1.0 0.8 0.2</rgb>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.25" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               jzz="0.1"/>
    </inertial>
  </link>

  <!-- ===== Left Wheel ===== -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="black">
        <rgb>0.0 0.0 0.0</rgb>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               jzz="0.001"/>
    </inertial>
  </link>

  <!-- ===== Right Wheel ===== -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="black">
        <rgb>0.0 0.0 0.0</rgb>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               jzz="0.001"/>
    </inertial>
  </link>

  <!-- ===== Caster Wheel ===== -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="black">
        <rgb>0.0 0.0 0.0</rgb>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               jzz="0.0001"/>
    </inertial>
  </link>

  <!-- ===== RGB-D Camera Link ===== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="cyan">
        <rgb>0.0 1.0 1.0</rgb>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               jzz="0.0001"/>
    </inertial>
  </link>

  <!-- ===== IMU Link ===== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="magenta">
        <rgb>1.0 0.0 1.0</rgb>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               jzz="0.00001"/>
    </inertial>
  </link>

  <!-- ===== Joints ===== -->

  <!-- Left wheel joint -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
  </joint>

  <!-- Right wheel joint -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
  </joint>

  <!-- Caster joint -->
  <joint name="caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
  </joint>

  <!-- ===== RGB-D Camera Plugin ===== -->
  <gazebo>
    <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
      <always_on>true</always_on>
      <updateRate>30</updateRate>
      <cameraName>rgb_camera</cameraName>
      <imageWidth>640</imageWidth>
      <imageHeight>480</imageHeight>
      <frameRate>30</frameRate>
      <cameraFrame>camera_link</cameraFrame>
      <iallowsRGB>true</iallowsRGB>
      <!-- <topicName>image_raw</topicName> -->
    </plugin>

    <!-- IMU Plugin -->
    <plugin name="imu_plugin" filename="libgazebo_ros_imu.so">
      <always_on>true</always_on>
      <updateRate>100</updateRate>
      <bodyName>base_link</bodyName>
      <topicName>imu/data</topicName>
      <frameId>imu_link</frameId>
      <rate>100</rate>
    </plugin>
  </gazebo>

  <!-- ===== Robot State Publisher (Joint State) ===== -->
  <!-- The joint_state_publisher will publish joint states for the wheel joints -->

  <!-- ===== TF Frames ===== -->
  <!--
    Expected TF tree:
    - world -> base_link (odometry)
    - base_link -> left_wheel (joint state)
    - base_link -> right_wheel (joint state)
    - base_link -> caster_wheel (joint state)
    - base_link -> camera_link (static transform, or published by camera_node)
    - camera_link -> camera_optical_frame (static transform)
    - base_link -> imu_link (via joint state or tf)
  -->
</robot>