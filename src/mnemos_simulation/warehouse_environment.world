                 iyy="20.0" iyz="0.0"
                 jzz="20.0"/>
      </inertial>
    </link>
  </model>

  <!-- Interior walls / aisles -->
  <model name="wall_aisle_1">
    <pose>0 -15 1.5 0 0 0</pose>
    <link name="wall_link">
      <visual>
        <geometry>
          <box size="80 0.1 2.0"/>
        </geometry>
        <material name="gray">
          <rgb>0.5 0.5 0.5</rgb>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="80 0.1 2.0"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="100.0"/>
        <inertia ixx="10.0" ixy="0.0" ixz="0.0"
                 iyy="10.0" iyz="0.0"
                 jzz="10.0"/>
      </inertial>
    </link>
  </model>

  <model name="wall_aisle_2">
