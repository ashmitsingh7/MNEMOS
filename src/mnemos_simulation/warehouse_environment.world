<?xml version="1.0"?>
<world name="warehouse_environment">

  <include>
    <package>gazebo_ros</package>
    <plugin name="physics_engine" filename="libgazebo_physics_engine.so">
      <verbose>0</verbose>
    </plugin>
  </include>

  <background>0.8 0.8 0.8 1</background>
  <sun>
    <ambient>0.4 0.4 0.4</ambient>
    <diffuse>0.8 0.8 0.8</diffuse>
    <specular>0.2 0.2 0.2</specular>
    <pose>-0.5 0.5 1.0 0 0 0</pose>
  </sun>

  <ground>
    <normal>0 0 1</normal>
    <size>80 80</size>
    <transparency>0.4</transparency>
    <material>Gazebo/Green</material>
  </ground>

  <!-- Robot spawn -->
  <include>
    <uri>file://mnemos_diff_drive.urdf</uri>
    <name>mnemos_robot</name>
    <pose>0 0 0.1 0 0 0</pose>
  </include>

  <!-- Warehouse Aisles -->

  <!-- Outer walls -->
  <model name="wall_outer_1">
    <pose>0 -40 1.5 0 0 0</pose>
    <link name="wall_link">
      <visual>
        <geometry>
          <box size="80 0.1 30"/>
        </geometry>
        <material name="gray">
          <rgb>0.5 0.5 0.5</rgb>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="80 0.1 30"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="200.0"/>
        <inertia ixx="20.0" ixy="0.0" ixz="0.0"
                 iyy="20.0" iyz="0.0"
                 jzz="20.0"/>
      </inertial>
    </link>
  </model>

  <model name="wall_outer_2">
    <pose>80 0 1.5 0 0 0</pose>
    <link name="wall_link">
      <visual>
        <geometry>
          <box size="0.1 80 30"/>
        </geometry>
        <material name="gray">
          <rgb>0.5 0.5 0.5</rgb>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.1 80 30"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="200.0"/>
        <inertia ixx="20.0" ixy="0.0" ixz="0.0"
                 iyy="20.0" iyz="0.0"
                 jzz="20.0"/>
      </inertial>
    </link>
  </model>

  <model name="wall_outer_3">
    <pose>0 40 1.5 0 0 0</pose>
    <link name="wall_link">
      <visual>
        <geometry>
          <box size="80 0.1 30"/>
        </geometry>
        <material name="gray">
          <rgb>0.5 0.5 0.5</rgb>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="80 0.1 30"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="200.0"/>
        <inertia ixx="20.0" ixy="0.0" ixz="0.0"
                 iyy="20.0" iyz="0.0"
                 jzz="20.0"/>
      </inertial>
    </link>
  </model>

  <model name="wall_outer_4">
    <pose>-80 0 1.5 0 0 0</pose>
    <link name="wall_link">
      <visual>
        <geometry>
          <box size="0.1 80 30"/>
        </geometry>
        <material name="gray">
          <rgb>0.5 0.5 0.5</rgb>
        </material>
      </visual>
      <collision>
        <geometry>
