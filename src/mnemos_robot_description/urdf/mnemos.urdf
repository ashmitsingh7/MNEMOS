<?xml version="1.0"?>
<robot name="mnemos">
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.24" length="0.12"/></geometry><material name="mnemos_yellow"><color rgba="1 0.72 0.08 1"/></material></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.24" length="0.12"/></geometry></collision>
    <inertial><origin xyz="0 0 0.12"/><mass value="7.0"/><inertia ixx="0.13" ixy="0" ixz="0" iyy="0.13" iyz="0" izz="0.20"/></inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="left_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry></visual></link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.23 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="right_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry></visual></link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.23 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="laser_frame"/><joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0.18 0 0.25" rpy="0 0 0"/></joint>
  <link name="camera_link"/><joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.18 0 0.32" rpy="0 0 0"/></joint>
  <link name="camera_optical_frame"/><joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/></joint>
  <link name="imu_link"/><joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.24" rpy="0 0 0"/></joint>
</robot>
